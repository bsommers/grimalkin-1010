# Build environment for the Linux desktop bundles (deb, rpm, AppImage).
# Debian 12 keeps the glibc requirement low enough for most current distros.
FROM rust:1-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        libwebkit2gtk-4.1-dev libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev \
        build-essential curl wget file rpm xdg-utils nodejs npm \
        xvfb xauth libgl1-mesa-dri dbus-x11 \
    && rm -rf /var/lib/apt/lists/*
ENV APPIMAGE_EXTRACT_AND_RUN=1 NO_STRIP=true
