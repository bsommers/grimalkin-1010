{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grimalkin 1010",
  "version": "1.0.0",
  "identifier": "com.bsommers.grimalkin1010",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/make-dist.js",
    "beforeDevCommand": "node scripts/make-dist.js"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GRIMALKIN 1010",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "ArcadeGame",
    "shortDescription": "Two-mode arcade space shooter",
    "longDescription": "Mine the rocks. Arm the bombs. Do not let them finish the cat.",
    "copyright": "Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
